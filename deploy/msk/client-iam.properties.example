# Kafka CLI client properties for Amazon MSK with IAM auth (create-topics.sh
# KAFKA_COMMAND_CONFIG). Credentials come from the pod's IRSA role; nothing
# secret is in this file. Needs the aws-msk-iam-auth jar on the CLI classpath.
security.protocol=SASL_SSL
sasl.mechanism=AWS_MSK_IAM
sasl.jaas.config=software.amazon.msk.auth.iam.IAMLoginModule required;
sasl.client.callback.handler.class=software.amazon.msk.auth.iam.IAMClientCallbackHandler
